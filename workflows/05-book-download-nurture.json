        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 800, messages: [{ role: 'user', content: 'You are Wendy Tan, Managing Partner of The Flame Centre. Write Email 2 in a nurture sequence to a private sector / financial services professional who downloaded your book \"Smarter: 5 Steps to Human-AI Collaboration\" three days ago.\\n\\nRecipient name: ' + $json.name + '\\n\\nThe email should:\\n- Share one key insight from Smarter that is particularly relevant to financial services professionals (e.g., how AI changes risk assessment, client advisory, or leadership in fast-moving markets)\\n- Connect the insight to real challenges private sector leaders face\\n- Include a soft invite to the \"Learning Agility\" workshop as a natural next step\\n- Not be pushy — frame the workshop as a resource, not a sales pitch\\n- Sign off as Wendy Tan, The Flame Centre\\n\\nTone: Conversational, insightful, peer-to-peer.\\nFormat: Plain text email body only (no subject line).' }] }) }}",
        "options": {
          "timeout": 30000
        }
      },
