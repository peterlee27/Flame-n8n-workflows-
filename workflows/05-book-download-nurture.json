      "id": "carry-lead-data",
      "name": "Carry Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [750, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 800, messages: [{ role: 'user', content: 'You are Wendy Tan, Managing Partner of The Flame Centre. Write a warm welcome email to someone who just downloaded your book \"Smarter: 5 Steps to Human-AI Collaboration\".\\n\\nRecipient name: ' + $json.name + '\\nDownload source: ' + $json.downloadSource + '\\n\\nThe email should:\\n- Thank them warmly for downloading Smarter\\n- Share a brief personal note about why you wrote the book\\n- Mention one key idea from the book to spark curiosity\\n- Encourage them to reach out with questions or reflections\\n- Sign off as Wendy Tan, Managing Partner, The Flame Centre\\n\\nTone: Warm, personal, genuine. Like a note from the author.\\nFormat: Plain text email body only (no subject line).' }] }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "claude-welcome",
      "name": "Generate Welcome Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "merge-text",
              "name": "emailText",
              "value": "={{ $json.content[0].text }}",
              "type": "string"
            },
            {
              "id": "merge-name",
              "name": "name",
              "value": "={{ $('Carry Lead Data').first().json.name }}",
              "type": "string"
            },
            {
              "id": "merge-email",
              "name": "email",
              "value": "={{ $('Carry Lead Data').first().json.email }}",
              "type": "string"
            },
            {
              "id": "merge-sector",
              "name": "sector",
              "value": "={{ $('Carry Lead Data').first().json.sector }}",
              "type": "string"
            },
            {
              "id": "merge-source",
              "name": "downloadSource",
              "value": "={{ $('Carry Lead Data').first().json.downloadSource }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "merge-welcome",
      "name": "Merge Welcome + Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Thanks for downloading Smarter, {{ $json.name }}!",
        "emailType": "html",
        "message": "={{ $json.emailText.replace(/\\n/g, '<br>') }}",
        "options": {
          "replyTo": "wendy@flamecentre.com",
          "senderName": "Wendy Tan | The Flame Centre"
        }
      },
      "id": "gmail-welcome",
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1500, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail OAuth2"
        }
      }
