        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 800, messages: [{ role: 'user', content: 'You are Wendy Tan, Managing Partner of The Flame Centre. Write Email 3 — the final email in a nurture sequence for someone who downloaded your book \"Smarter: 5 Steps to Human-AI Collaboration\" about a week ago.\\n\\nRecipient name: ' + $json.name + '\\nSector: ' + $json.sector + '\\n\\nThe email should:\\n- Acknowledge this is the final email in the series — no pressure\\n- Invite them to an upcoming keynote or workshop (keep it general, not a specific date)\\n- Include a clear CTA link: https://www.flamecentre.com/programs\\n- Frame it as an opportunity to go deeper on the ideas in Smarter\\n- Leave the door open for future connection\\n- Sign off as Wendy Tan, The Flame Centre\\n\\nTone: Warm, encouraging, respectful of their time. Clean close.\\nFormat: Plain text email body only (no subject line).' }] }) }}",
        "options": {
          "timeout": 30000
        }
      },
