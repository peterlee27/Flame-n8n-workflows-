        "assignments": {
          "assignments": [
            {
              "id": "persist-name",
              "name": "name",
              "value": "={{ $('Merge Welcome + Lead Data').first().json.name }}",
              "type": "string"
            },
            {
              "id": "persist-email",
              "name": "email",
              "value": "={{ $('Merge Welcome + Lead Data').first().json.email }}",
              "type": "string"
            },
            {
              "id": "persist-sector",
              "name": "sector",
              "value": "={{ $('Merge Welcome + Lead Data').first().json.sector }}",
              "type": "string"
            },
            {
              "id": "persist-source",
              "name": "downloadSource",
              "value": "={{ $('Merge Welcome + Lead Data').first().json.downloadSource }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "persist-for-wait1",
      "name": "Persist Data for Wait 1",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1750, 300]
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "days"
      },
      "id": "wait-3-days",
      "name": "Wait 3 Days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "check-sector",
              "leftValue": "={{ $json.sector }}",
              "rightValue": "public",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "if-sector-email2",
      "name": "Check Sector for Email 2",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 800, messages: [{ role: 'user', content: 'You are Wendy Tan, Managing Partner of The Flame Centre. Write Email 2 in a nurture sequence to a public sector professional who downloaded your book \"Smarter: 5 Steps to Human-AI Collaboration\" three days ago.\\n\\nRecipient name: ' + $json.name + '\\n\\nThe email should:\\n- Share one key insight from Smarter that is particularly relevant to public servants (e.g., how AI can enhance policy analysis, citizen services, or decision-making in government)\\n- Connect the insight to real challenges public sector leaders face\\n- Include a soft invite to the \"Thinking with AI\" workshop as a natural next step\\n- Not be pushy — frame the workshop as a resource, not a sales pitch\\n- Sign off as Wendy Tan, The Flame Centre\\n\\nTone: Thoughtful, helpful, collegial.\\nFormat: Plain text email body only (no subject line).' }] }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "claude-email2-public",
      "name": "Generate Email 2 – Public",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2550, 150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
