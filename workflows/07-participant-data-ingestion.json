        "bodyContent": "=A participant list email was received but could not be automatically processed.\n\nSender: {{ $('Outlook — Watch Inbox').item.json.from?.emailAddress?.address || 'Unknown' }}\nSubject: {{ $('Outlook — Watch Inbox').item.json.subject || '(No subject)' }}\nReason: {{ $json.reason || 'Unknown error' }}\n\nPlease review the original email and process the participant list manually.",
