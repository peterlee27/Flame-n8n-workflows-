    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 2000, messages: [{ role: 'user', content: 'You are a data extraction assistant for Flame Centre, a training company in Singapore.\\n\\nYou are receiving an email body and optionally pre-parsed spreadsheet rows from an attachment. Your job: clean and normalize the data, extract participant fields, and extract metadata from the email.\\n\\n--- EMAIL SUBJECT ---\\n' + $json.emailSubject + '\\n\\n--- EMAIL BODY ---\\n' + $json.emailBody + '\\n\\n--- PRE-PARSED ATTACHMENT ROWS (JSON) ---\\n' + $json.parsedRows + '\\n\\n--- INSTRUCTIONS ---\\nIf pre-parsed rows are provided and non-empty, use those as the primary data source. Use the email body for metadata and any missing context.\\nIf no attachment rows, extract participants from the email body directly.\\n\\nOutput a JSON object with two keys:\\n1. \"participants\" - array of participant objects with fields:\\n   - name (full name)\\n   - email\\n   - organisation\\n   - designation\\n   - nric_last4 (last 4 chars of NRIC, e.g. \"567A\" — only if present)\\n   - citizenship (Singaporean / PR / Foreigner — only if present)\\n\\n2. \"meta\" - object with fields:\\n   - sender_name\\n   - sender_email\\n   - workshop_hint (any workshop or course name mentioned)\\n   - date_hint (any date mentioned, in DD Mon YYYY format)\\n   - participant_count (total count if mentioned)\\n\\nIf the data is too messy or unreadable, return:\\n{\"error\": \"EXTRACTION_FAILED\", \"reason\": \"brief explanation\"}\\n\\nReturn ONLY the JSON object. No preamble, no markdown, no explanation.' }] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "claude-extract",
      "name": "Claude — Extract Participants",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse Claude's response and check for extraction failure\nconst responseText = $input.first().json.content[0].text;\nlet parsed;\ntry {\n  parsed = JSON.parse(responseText);\n} catch (e) {\n  return [{ json: { error: 'EXTRACTION_FAILED', reason: 'Claude response was not valid JSON: ' + e.message } }];\n}\nreturn [{ json: parsed }];"
      },
      "id": "parse-claude-response",
      "name": "Parse Claude Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, 300]
