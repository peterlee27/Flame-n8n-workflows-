    {
      "parameters": {
        "jsCode": "// Match logic: score the incoming participant list against active workshops\nconst extracted = $('Parse Claude Response').first().json;\nconst meta = extracted.meta || {};\nconst senderEmail = meta.sender_email || $('Outlook — Watch Inbox').first().json.from?.emailAddress?.address || '';\nconst senderDomain = senderEmail.split('@')[1] || '';\nconst accountHint = (meta.workshop_hint || '').toLowerCase();\nconst dateHint = meta.date_hint || '';\n\nconst dashboardRows = $('Google Sheets — Read Master Dashboard').all().map(item => item.json);\n\nlet bestMatch = null;\nlet bestScore = 0;\n\nfor (const row of dashboardRows) {\n  if (!row.workshop_id || row.status === 'Archived') continue;\n  \n  let score = 0;\n  \n  // Sender domain match (+3)\n  const clientEmail = (row.client_contact_email || '').toLowerCase();\n  const clientDomain = clientEmail.split('@')[1] || '';\n  if (senderDomain && clientDomain && senderDomain.toLowerCase() === clientDomain) {\n    score += 3;\n  }\n  \n  // Account name fuzzy match (+2)\n  const accountName = (row.account_name || '').toLowerCase();\n  if (accountHint && accountName && (accountName.includes(accountHint) || accountHint.includes(accountName))) {\n    score += 2;\n  }\n  \n  // Date match (+2)\n  if (dateHint && row.start_date) {\n    const rowDate = new Date(row.start_date).toDateString();\n    const hintDate = new Date(dateHint).toDateString();\n    if (rowDate === hintDate) {\n      score += 2;\n    }\n  }\n  \n  // Workshop title keyword match (+1)\n  const workshopTitle = (row.workshop_title || '').toLowerCase();\n  if (accountHint && workshopTitle) {\n    const keywords = accountHint.split(/\\s+/);\n    if (keywords.some(kw => kw.length > 3 && workshopTitle.includes(kw))) {\n      score += 1;\n    }\n  }\n  \n  if (score > bestScore) {\n    bestScore = score;\n    bestMatch = row;\n  }\n}\n\nlet confidence;\nif (bestScore >= 4) {\n  confidence = 'HIGH_CONFIDENCE';\n} else if (bestScore >= 1) {\n  confidence = 'LOW_CONFIDENCE';\n} else {\n  confidence = 'NO_MATCH';\n}\n\nreturn [{\n  json: {\n    confidence,\n    score: bestScore,\n    matchedWorkshop: bestMatch,\n    participants: extracted.participants || [],\n    meta\n  }\n}];"
      },
      "id": "match-logic",
      "name": "Function — Match to Workshop",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2700, 200]
