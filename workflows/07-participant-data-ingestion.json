    {
      "parameters": {
        "jsCode": "// Generate Skilleto-ready CSV data for admin upload\nconst data = $('Read Matched Workshop Row').first().json;\nconst participants = data.participants || [];\n\n// Skilleto CSV headers\nconst headers = ['Name', 'Email', 'Organisation', 'Designation', 'NRIC (Last 4)', 'Citizenship'];\nconst rows = participants.map(p => [\n  p.name || '',\n  p.email || '',\n  p.organisation || '',\n  p.designation || '',\n  p.nric_last4 || '',\n  p.citizenship || ''\n]);\n\nconst csvContent = [headers.join(','), ...rows.map(r => r.map(cell => '\"' + (cell || '').replace(/\"/g, '\"\"') + '\"').join(','))].join('\\n');\n\nreturn [{\n  json: {\n    workshopId: data.workshop_id,\n    workshopTitle: data.workshop_title,\n    participantCount: participants.length,\n    csvContent\n  },\n  binary: {\n    data: {\n      data: Buffer.from(csvContent).toString('base64'),\n      mimeType: 'text/csv',\n      fileName: data.workshop_id + '_Skilleto_Upload.csv'\n    }\n  }\n}];"
      },
      "id": "generate-skilleto-csv",
      "name": "Function — Generate Skilleto CSV",
