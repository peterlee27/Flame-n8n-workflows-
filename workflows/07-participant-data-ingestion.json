    {
      "parameters": {
        "jsCode": "// Read the matched workshop row details\nconst matchData = $('Function — Match to Workshop').first().json;\nconst workshop = matchData.matchedWorkshop;\n\nif (!workshop) {\n  throw new Error('No matched workshop found');\n}\n\nreturn [{\n  json: {\n    workshop_id: workshop.workshop_id,\n    workshop_title: workshop.workshop_title,\n    account_name: workshop.account_name,\n    start_date: workshop.start_date,\n    funding_type: workshop.funding_type || 'Non-Funded',\n    participant_sheet_link: workshop.participant_sheet_link || '',\n    participant_list_received: workshop.participant_list_received || 'No',\n    skilleto_done: workshop.skilleto_done || 'NA',\n    tpg_done: workshop.tpg_done || 'NA',\n    participants: matchData.participants,\n    meta: matchData.meta\n  }\n}];"
      },
